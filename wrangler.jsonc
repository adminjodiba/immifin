// Runtime secrets — set in Cloudflare Dashboard (Production/Preview) or local
// .dev.vars (gitignored). Do NOT commit secret values to this file:
//   NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
//   CLERK_SECRET_KEY
//   CLERK_WEBHOOK_SECRET
//   NEXT_PUBLIC_SUPABASE_URL
//   SUPABASE_SERVICE_ROLE_KEY
//   GOOGLE_SERVICE_ACCOUNT_KEY
//   VISA_BULLETIN_GOOGLE_SHEET_ID
//   DAILY_SHEET_SYNC_SECRET
//   IMMIFIN_WRITE_FREEZE
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "immifin",
  // Custom worker adds scheduled(); fetch still comes from OpenNext.
  "main": "./cloudflare/custom-worker.ts",
  "compatibility_date": "2026-06-23",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "immifin"
    }
  ],
  // OpenNext persistent cache (S7A-PERF-003B) — CONFIGURED LOCALLY, not yet
  // Production-deployed. Binding names must match @opennextjs/cloudflare 1.20.1.
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "immifin-prod-opennext-inc-cache"
    }
  ],
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "immifin-prod-opennext-tag-cache",
      "database_id": "c1c789db-3370-4f40-9611-172ed7b67fde"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler"
      }
    ]
  },
  // First Durable Object migration for Worker immifin (no prior DO migrations
  // on production version e5e95e97 / committed wrangler.jsonc).
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler"]
    }
  ],
  "vars": {
    "NEXT_PUBLIC_CLERK_SIGN_IN_URL": "/login",
    "NEXT_PUBLIC_CLERK_SIGN_UP_URL": "/signup"
  },
  "observability": {
    "enabled": true
  },
  // Workers Paid required — Free rejects this (API 100328).
  // Raises per-request CPU above Free's ~10 ms hard cap (Error 1102 / OpenNext cold start).
  "limits": {
    "cpu_ms": 60000
  },
  // DST-safe 12:01 AM America/Chicago: CDT=05:01 UTC, CST=06:01 UTC.
  // Handler proceeds only when Chicago local time is 00:01.
  // Not live until a Production deploy. Set Worker secret DAILY_SHEET_SYNC_SECRET first.
  "triggers": {
    "crons": [
      "1 5 * * *",
      "1 6 * * *"
    ]
  }
}
